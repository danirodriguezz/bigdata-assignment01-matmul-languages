{
  "_comment": "Assignment 1 experiment configuration. Edit sizes/repetitions/budgets here; scripts/run_experiments.py reads it. For each (language, n) the first rule with n <= max_n gives W (in-process warm-ups), R (measured in-process reps) and P (separate process runs; k = P*R measured samples). split_processes=true releases the machine-wide lock between process runs.",
  "assignment": "A1",
  "inputs": {
    "seed": 42,
    "sizes": [
      1,
      64,
      128,
      256,
      384,
      512,
      768,
      1024,
      1536,
      2048
    ]
  },
  "budgets": {
    "timeout_s": 600,
    "memory_budget_gib": 8,
    "total_benchmark_minutes": 90
  },
  "languages": {
    "c": {
      "build": "gcc -O2 -std=c11 -Wall -Wextra -o build/c/matmul_naive_c src/c/bench_naive.c src/c/matmul_naive.c src/c/matrix_io.c -lm",
      "cmd": [
        "build/c/matmul_naive_c"
      ],
      "method": "naive_ijk"
    },
    "java": {
      "build": "javac --release 21 -d build/java src/java/MatMulNaive.java",
      "cmd": [
        "java",
        "-Xms1g",
        "-Xmx4g",
        "-XX:+UseG1GC",
        "-cp",
        "build/java",
        "MatMulNaive"
      ],
      "method": "naive_ijk"
    },
    "python": {
      "build": "(interpreted; no build step)",
      "cmd": [
        ".venv/bin/python",
        "src/python/matmul_naive.py"
      ],
      "method": "naive_ijk"
    },
    "c_O0": {
      "build": "gcc -O0 -std=c11 -Wall -Wextra -o build/c/matmul_naive_c_O0 src/c/bench_naive.c src/c/matmul_naive.c src/c/matrix_io.c -lm",
      "cmd": [
        "build/c/matmul_naive_c_O0"
      ],
      "language_label": "c",
      "method": "naive_ijk_gcc-O0"
    },
    "c_O3": {
      "build": "gcc -O3 -std=c11 -Wall -Wextra -o build/c/matmul_naive_c_O3 src/c/bench_naive.c src/c/matmul_naive.c src/c/matrix_io.c -lm",
      "cmd": [
        "build/c/matmul_naive_c_O3"
      ],
      "language_label": "c",
      "method": "naive_ijk_gcc-O3"
    },
    "c_O3_native": {
      "build": "gcc -O3 -march=native -std=c11 -Wall -Wextra -o build/c/matmul_naive_c_O3_native src/c/bench_naive.c src/c/matmul_naive.c src/c/matrix_io.c -lm",
      "cmd": [
        "build/c/matmul_naive_c_O3_native"
      ],
      "language_label": "c",
      "method": "naive_ijk_gcc-O3_march_native"
    },
    "c_O2": {
      "build": "gcc -O2 -std=c11 -Wall -Wextra -o build/c/matmul_naive_c src/c/bench_naive.c src/c/matmul_naive.c src/c/matrix_io.c -lm   (same binary as the controlled comparison)",
      "cmd": [
        "build/c/matmul_naive_c"
      ],
      "language_label": "c",
      "method": "naive_ijk_gcc-O2"
    }
  },
  "common_args": {
    "min_sample_time_s": 0.2
  },
  "env": {
    "OMP_NUM_THREADS": "1",
    "OPENBLAS_NUM_THREADS": "1",
    "MKL_NUM_THREADS": "1"
  },
  "experiments": {
    "pilot": {
      "output": "results/raw/pilot_size_sweep.csv",
      "sizes": [
        64,
        128,
        256,
        512
      ],
      "languages": [
        "c",
        "java",
        "python"
      ],
      "rules": [
        {
          "max_n": 1000000,
          "warmup": 3,
          "reps": 2,
          "process_runs": 1
        }
      ]
    },
    "pilot_large": {
